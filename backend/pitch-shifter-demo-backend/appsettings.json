{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "HttpsRedirection": {
    "Enabled": true
  },
  "Audio": {
    "SamplesPath": "Content/Samples",
    "DefaultFileName": null,
    "EnableFallbackTone": true
  }
}
