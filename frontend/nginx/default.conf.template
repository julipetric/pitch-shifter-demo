server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # API traffic goes to the backend so the browser only ever talks to this origin.
    # Buffering is off so processed audio reaches the player as the backend encodes it.
    location ~ ^/(api|health|diagnostics|swagger)(/|$) {
        proxy_pass http://${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Hashed build assets can be cached indefinitely.
    location ~* \.(?:js|css|woff2?|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Single-page app: unknown paths fall back to the shell.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
